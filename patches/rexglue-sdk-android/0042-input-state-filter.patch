+/**
+ * Dragon Blast (0042): a function the input system calls with a player's merged controller state (every pad and the
+ * on-screen controls of that player) before the game sees it. Raging Blast 2's Tenkaichi 3 scheme rewrites the
+ * buttons there during fights (android/native/src/bt3_controls.cpp). None by default.
+ */
+#pragma once
+
+#include <cstdint>
+
+#include <rex/input/input.h>
+
+namespace rex::input {
+
+using StateFilter = void (*)(uint32_t user_index, X_INPUT_STATE* state);
+void SetStateFilter(StateFilter filter);
+
+}  // namespace rex::input
