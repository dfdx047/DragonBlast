 #include <rex/ui/window_sdl.h>
 
+// Dragon Blast (0043): diagnostic for the UI thread's SDL loop (see RunMainMessageLoop).
+REXCVAR_DEFINE_BOOL(ui_loop_event_log, false, "UI",
