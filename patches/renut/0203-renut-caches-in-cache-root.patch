 #include <rex/frame_latency.h>
 #include <rex/perf/frame_rate.h>
 #include "renut_engine/display_sync.h"
@@ -1432,9 +1433,18 @@
 #endif
 }
 
+// Dragon Blast (renut/0203): the runtime's cache_root when set (Android: the app's files/cache; the executable's
+// folder there is the APK's read-only library folder), else the executable's folder.
+static std::filesystem::path RenutCacheBase(bool cache_subfolder) {
+  const std::string &root = REXCVAR_GET(cache_root);
+  if (!root.empty())
+    return std::filesystem::path(root);
+  return cache_subfolder ? rex::filesystem::GetExecutableFolder() / "cache" : rex::filesystem::GetExecutableFolder();
+}
+
 std::filesystem::path NextToExecutable(const std::string &path) {
   const std::filesystem::path p(path);
-  return p.is_relative() ? rex::filesystem::GetExecutableFolder() / p : p;
+  return p.is_relative() ? RenutCacheBase(false) / p : p;
 }
 
 
