Dragon Blast (2026-11-13): counters in the command buffer hooks (Begin, End, Run recorded into a buffer or queued),
which the glue logs every 10 s with the draw hooks' (android/native/src/renut/renut_glue.cpp). Raging Blast 2 draws
into command buffers on its two no-hardware devices and runs them on the title device (docs/renut/HOOKMAP_RB2.md).

diff --git a/app/src/renut_engine/gpu/d3d/hooks/device.cpp b/app/src/renut_engine/gpu/d3d/hooks/device.cpp
--- a/app/src/renut_engine/gpu/d3d/hooks/device.cpp
+++ b/app/src/renut_engine/gpu/d3d/hooks/device.cpp
@@ -698,9 +698,16 @@
 //     DWORD TileCount) [0x82657CB0]
 // The device records into the buffer: the draws on the host (command_buffers.h),
 // so the buffer's segments and the reset of their allocator are left out.
+// Dragon Blast (renut/0202): how often the command buffer hooks run (the glue logs them, renut_glue.cpp).
+extern "C" {
+std::atomic<uint32_t> rb2_renut_cb_begin{0}, rb2_renut_cb_end{0}, rb2_renut_cb_run_recorded{0},
+    rb2_renut_cb_run_queued{0};
+}
+
 u32 D3DDevice_BeginCommandBuffer_hook(u32 device_va, u32 command_buffer, u32 flags,
                                       u32 inherit_tags, u32 /*unused*/, u32 tiling_rects,
                                       u32 tile_count) {
+  rb2_renut_cb_begin.fetch_add(1, std::memory_order_relaxed);
   // A Begin*Vertices draw recorded into the previous buffer.
   FlushDeferredVertices(device_va);
   native::Device d = native::DeviceAt(device_va);
@@ -817,6 +824,7 @@
 // Begin); then everything is unbound, and the device is pointed at its side
 // buffer until the next Begin.
 u32 D3DDevice_EndCommandBuffer_hook(u32 device_va) {
+  rb2_renut_cb_end.fetch_add(1, std::memory_order_relaxed);
   FlushDeferredVertices(device_va);
   native::Device d = native::DeviceAt(device_va);
   if (!d)
@@ -858,8 +866,10 @@
   if (!command_buffer)
     return;
   if (IsRecordingCommandBuffer(device_va)) {
+    rb2_renut_cb_run_recorded.fetch_add(1, std::memory_order_relaxed);
     RecordRun(device_va, command_buffer);
   } else {
+    rb2_renut_cb_run_queued.fetch_add(1, std::memory_order_relaxed);
     RunReadyCallbacks();
     QueueRunCommandBuffer(device_va, command_buffer);
   }
