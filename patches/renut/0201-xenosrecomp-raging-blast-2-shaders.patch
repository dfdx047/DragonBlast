+// Dragon Blast (2026-11-13): a shader constant named like a swizzle (Raging Blast 2 has "z") becomes a macro that
+// breaks every ".z" in the shader; such names get a prefix. The returned text lives as long as the program.
+static const char* banjoConstantName(const uint8_t* name)
+{
+    const char* text = reinterpret_cast<const char*>(name);
+    const size_t length = strlen(text);
+    const bool xyzw = length >= 1 && length <= 4 && strspn(text, "xyzw") == length;
+    const bool rgba = length >= 1 && length <= 4 && strspn(text, "rgba") == length;
+    if (!xyzw && !rgba)
+        return text;
+    static std::mutex mutex;
+    static std::unordered_set<std::string> names;
+    std::lock_guard lock(mutex);
+    return names.insert(std::string("c_") + text).first->c_str();
+}
+
