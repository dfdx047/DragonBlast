 #include <plume_render_interface.h>
+#if defined(__ANDROID__)
+#include <plume_vulkan.h>  // Zandatsu (renut/0032)
+#endif
 
 #include <rex/cvar.h>
 #include <rex/perf/frame_rate.h>  // Zandatsu (renut/0025): the display's refresh, the presents
@@ -40,6 +43,12 @@
 
 // banjo-nx (2026-10-17, deko3d renderer tests): the captures copy the game's frame texture as it is (4-byte formats only,
 // its channels as BGRA), without the scan-out pass: which of the two a wrong capture comes from.
+REXCVAR_DEFINE_STRING(swordman_renut_scissor_pass, "auto", "Banjo/Renut",
+                      "Zandatsu: each scissor change opens another render pass with the scissor as its render area: "
+                      "auto (three-digit Mali GPUs), true or false");
+REXCVAR_DEFINE_STRING(swordman_renut_scissor_area, "exact", "Banjo/Renut",
+                      "Zandatsu: the render area of those passes: exact (the scissor), 16 or 64 (the scissor widened "
+                      "to blocks of that size) or full (the whole target)");
 REXCVAR_DEFINE_STRING(swordman_renut_present_own_list, "auto", "Banjo/Renut",
                       "Zandatsu: the output to the screen in a command list of its own: auto (three-digit Mali GPUs), "
                       "true or false");
@@ -157,7 +166,30 @@ bool MaliWithThreeDigits(const std::string &name) {
   return false;
 }
 
+// Zandatsu (renut/0032, issues #2 e #36): o minimapa fora do quadro nas mesmas Mali; ver plume_vulkan.cpp.
+// renut/0036: lido a cada frame (o menu do jogo troca os dois ao vivo, para o teste na POCO X7 Pro), com log na troca.
+void ApplyScissorPass(VideoState &s) {
+  static const bool mali = MaliWithThreeDigits(s.device->getDescription().name);
+  static std::string lastPass, lastArea;
+  const std::string mode = REXCVAR_GET(swordman_renut_scissor_pass);
+  const std::string area = REXCVAR_GET(swordman_renut_scissor_area);
+  if (mode == lastPass && area == lastArea)
+    return;
+  lastPass = mode;
+  lastArea = area;
+  const bool on = mode == "true" || (mode != "false" && mali);
+  const int areaMode = area == "16" ? 16 : area == "64" ? 64 : area == "full" ? -1 : 0;
+  plume::SetAndroidScissorPass(on);
+  plume::SetAndroidScissorArea(areaMode);
+  RGPU_INFO("swordman_renut_scissor_pass = {}: {}; swordman_renut_scissor_area = {}: {}", mode,
+            on ? "um passe por scissor" : "scissor no mesmo passe", area,
+            areaMode == 0 ? "renderArea exato" : areaMode < 0 ? "renderArea do alvo inteiro"
+                                                           : areaMode == 16 ? "renderArea em blocos de 16"
+                                                                            : "renderArea em blocos de 64");
+}
+
 bool UseOwnPresent(VideoState &s) {
+  ApplyScissorPass(s);
   static const bool wanted = [&] {
     const std::string mode = REXCVAR_GET(swordman_renut_present_own_list);
     const bool on = mode == "true" || (mode != "false" && MaliWithThreeDigits(s.device->getDescription().name));
